{
  "name": "rpgengine",
  "version": "0.0.0",
  "description": "",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite --host",
    "start": "vite --host",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run typecheck && npx vitest run",
    "test:integration": "npm run build && npx playwright test",
    "test:integration-update": "npx playwright test --update-snapshots",
    "golden:update": "UPDATE_GOLDEN=1 npx vitest run src/engine/core/random/golden.spec.ts",
    "serve:vectors": "vite --port 5174 --strictPort"
  },
  "repository": {},
  "keywords": [
    "excalibur",
    "excaliburjs",
    "vite",
    "game-engine"
  ],
  "author": "",
  "license": "",
  "bugs": {},
  "homepage": "",
  "dependencies": {
    "excalibur": "0.32.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
